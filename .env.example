# A GitHub personal access token used server-side to call the GitHub API.
# Without it, requests are rate-limited to 60/hour (shared across all visitors)
# which is not enough for a full repo analysis. With a token, the limit is 5000/hour.
#
# Create one at https://github.com/settings/tokens (fine-grained, no scopes/permissions
# needed for public repo read access) and paste it below.
GITHUB_TOKEN=

# Optional: enables the "deep architecture scan" (real Arcan smell detection).
# Deploy the service in /worker (see worker/README.md) and put its URL here.
# Without this, the deep-scan button is disabled with an explanatory message.
ARCAN_WORKER_URL=

# Optional: must match WORKER_AUTH_TOKEN set on the worker, if you set one.
ARCAN_WORKER_TOKEN=
